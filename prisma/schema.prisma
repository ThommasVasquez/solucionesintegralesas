generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATRON
  ADMIN
  TECNICO
  AGENDADOR
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  password      String    // Hasheado con bcrypt
  role          UserRole  @default(TECNICO)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?   // ID del usuario que lo creó
  
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]
  
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // 'CREATE', 'UPDATE', 'DELETE', 'VIEW'
  resource  String   // 'USER', 'SHEET', 'CELL'
  details   Json?    // Datos adicionales del cambio
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model GoogleSheetConfig {
  id              String   @id @default(cuid())
  spreadsheetId   String   @unique
  spreadsheetName String
  allowedSheets   String[] // Array de nombres de pestañas permitidas
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("google_sheet_configs")
}

model WhatsAppMessage {
  id        String   @id @default(cuid())
  chatId    String   // Identificador de la conversación (ej: número de teléfono o nombre del cliente)
  sender    String   // Nombre del remitente en el mensaje
  content   String   // Contenido del mensaje
  timestamp DateTime // Fecha y hora en la que fue enviado/recibido
  direction String   // 'INBOUND' (Entrante de cliente) o 'OUTBOUND' (Saliente del negocio)
  createdAt DateTime @default(now())

  @@index([chatId])
  @@index([timestamp])
  @@map("whatsapp_messages")
}

